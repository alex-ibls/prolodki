DATABASE_URL=postgresql://prolodki:prolodki@localhost:5432/prolodki
# На сервере DATABASE_URL не задают. Подключение берётся отсюда, с SSL:
# POSTGRESQL_HOST=
# POSTGRESQL_PORT=5432
# POSTGRESQL_USER=
# POSTGRESQL_PASSWORD=
# POSTGRESQL_DBNAME=
AUTH_SECRET=replace-with-a-long-random-string
# Локально. На сервере не оставляйте localhost: либо уберите переменную,
# либо укажите публичный адрес, например https://lodki.in.ru.net
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# Пример для Яндекса: smtp.yandex.ru, порт 465, SMTP_SECURE=true, ящик и пароль приложения.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Ключ JavaScript API Яндекс.Карт. Нужен, чтобы в объявлении указать точку на карте.
YANDEX_MAPS_API_KEY=
