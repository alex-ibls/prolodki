// Схему меняет Prisma Migrate. Запросы приложения идут через Drizzle.

datasource db {
  provider = "postgresql"
}

model attribute_defs {
  id                      Int                       @id @default(autoincrement())
  category_id             Int
  code                    String
  name                    String
  unit                    String                    @default("")
  filterable              Boolean                   @default(true)
  featured                Boolean                   @default(false)
  icon                    String                    @default("")
  card_order              Int                       @default(0)
  data_type               String                    @default("number")
  categories              categories                @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "attribute_defs_category_id_categories_id_fk")
  listing_attributes      listing_attributes[]
  nomenclature_attributes nomenclature_attributes[]
}

model brands {
  id           Int            @id @default(autoincrement())
  slug         String         @unique(map: "brands_slug_unique")
  name         String         @unique(map: "brands_name_unique")
  sort         Int            @default(0)
  listings     listings[]
  nomenclature nomenclature[]
}

model cart_items {
  cart_id    String   @db.Uuid
  listing_id String   @db.Uuid
  qty        Int
  options    String   @default("")
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_cart_id_carts_id_fk")
  listings   listings @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_listing_id_listings_id_fk")

  @@id([cart_id, listing_id], map: "cart_items_cart_id_listing_id_pk")
}

model carts {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?      @unique(map: "carts_user_id_unique") @db.Uuid
  guest_token String?      @unique(map: "carts_guest_token_unique")
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  cart_items  cart_items[]
  users       users?       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "carts_user_id_users_id_fk")
}

model categories {
  id             Int              @id @default(autoincrement())
  parent_id      Int?
  slug           String           @unique(map: "categories_slug_unique")
  name           String
  sort           Int              @default(0)
  attribute_defs attribute_defs[]
  listings       listings[]
  nomenclature   nomenclature[]
}

model customers {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?         @unique(map: "customers_user_id_unique") @db.Uuid
  name       String
  phone      String          @default("")
  email      String          @default("")
  city       String          @default("")
  source     customer_source
  notes      String          @default("")
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  users      users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_user_id_users_id_fk")
  deals      deals[]
}

model deal_notes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deal_id    String   @db.Uuid
  author_id  String?  @db.Uuid
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deal_notes_author_id_users_id_fk")
  deals      deals    @relation(fields: [deal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deal_notes_deal_id_deals_id_fk")
}

model deals {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id   String       @db.Uuid
  order_id      String?      @unique(map: "deals_order_id_unique") @db.Uuid
  assignee_id   String?      @db.Uuid
  title         String
  amount_kopeks Int          @default(0)
  status        deal_status  @default(new)
  comment       String       @default("")
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)
  deal_notes    deal_notes[]
  users         users?       @relation(fields: [assignee_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deals_assignee_id_users_id_fk")
  customers     customers    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deals_customer_id_customers_id_fk")
  orders        orders?      @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deals_order_id_orders_id_fk")
}

model favorites {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id  String   @db.Uuid
  user_id     String?  @db.Uuid
  guest_token String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  listings    listings @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "favorites_listing_id_listings_id_fk")
  users       users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "favorites_user_id_users_id_fk")

  @@unique([listing_id, guest_token], map: "favorites_guest_listing")
  @@unique([listing_id, user_id], map: "favorites_user_listing")
}

model kit_items {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                   String
  name                   String
  price_kopeks           Int
  image_path             String                   @default("")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  nomenclature_kit_links nomenclature_kit_links[]
}

model listing_attributes {
  listing_id       String         @db.Uuid
  attribute_def_id Int
  value_number     Float?
  value_text       String?
  attribute_defs   attribute_defs @relation(fields: [attribute_def_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listing_attributes_attribute_def_id_attribute_defs_id_fk")
  listings         listings       @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listing_attributes_listing_id_listings_id_fk")

  @@id([listing_id, attribute_def_id], map: "listing_attributes_listing_id_attribute_def_id_pk")
}

model listing_events {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id  String             @db.Uuid
  kind        listing_event_kind
  user_id     String?            @db.Uuid
  guest_token String?
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  listings    listings           @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listing_events_listing_id_listings_id_fk")
  users       users?             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listing_events_user_id_users_id_fk")

  @@index([listing_id, kind], map: "listing_events_listing_kind_idx")
}

model listing_images {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id String   @db.Uuid
  path       String
  sort       Int      @default(0)
  listings   listings @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listing_images_listing_id_listings_id_fk")
}

model listings {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source             listing_source
  seller_user_id     String?                  @db.Uuid
  organization_id    String?                  @db.Uuid
  nomenclature_id    String?                  @unique(map: "listings_nomenclature_id_unique") @db.Uuid
  category_id        Int
  title              String
  slug               String                   @unique(map: "listings_slug_unique")
  description        String                   @default("")
  brand              String                   @default("")
  model              String                   @default("")
  year               Int?
  condition          item_condition
  price_kopeks       Int
  compare_at_kopeks  Int?
  city               String                   @default("")
  quantity           Int                      @default(1)
  status             listing_status           @default(draft)
  rejection_reason   String                   @default("")
  search_vector      Unsupported("tsvector")?
  created_at         DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                 @default(now()) @db.Timestamptz(6)
  brand_id           Int?
  on_order           Boolean                  @default(false)
  lat                Float?
  lng                Float?
  logistics_kopeks   Int?
  lead_time          String                   @default("")
  cart_items         cart_items[]
  favorites          favorites[]
  listing_attributes listing_attributes[]
  listing_events     listing_events[]
  listing_images     listing_images[]
  brands             brands?                  @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listings_brand_id_brands_id_fk")
  categories         categories               @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listings_category_id_categories_id_fk")
  nomenclature       nomenclature?            @relation(fields: [nomenclature_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listings_nomenclature_id_nomenclature_id_fk")
  organizations      organizations?           @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listings_organization_id_organizations_id_fk")
  users              users?                   @relation(fields: [seller_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "listings_seller_user_id_users_id_fk")
  order_items        order_items[]
  view_history       view_history[]

  @@index([search_vector], map: "listings_search_idx", type: Gin)
}

model nomenclature {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                     String                    @unique(map: "nomenclature_sku_unique")
  category_id             Int
  title                   String
  brand                   String                    @default("")
  model                   String                    @default("")
  year                    Int?
  description             String                    @default("")
  price_kopeks            Int
  compare_at_kopeks       Int?
  quantity_on_hand        Int                       @default(0)
  quantity_reserved       Int                       @default(0)
  city                    String                    @default("")
  is_published            Boolean                   @default(false)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  brand_id                Int?
  on_order                Boolean                   @default(false)
  logistics_kopeks        Int?
  lead_time               String                    @default("")
  listings                listings?
  brands                  brands?                   @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "nomenclature_brand_id_brands_id_fk")
  categories              categories                @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "nomenclature_category_id_categories_id_fk")
  nomenclature_attributes nomenclature_attributes[]
  nomenclature_images     nomenclature_images[]
  nomenclature_kit_groups nomenclature_kit_groups[]
  order_items             order_items[]
  stock_movements         stock_movements[]
}

model nomenclature_attributes {
  nomenclature_id  String         @db.Uuid
  attribute_def_id Int
  value_number     Float?
  value_text       String?
  attribute_defs   attribute_defs @relation(fields: [attribute_def_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "nomenclature_attributes_attribute_def_id_attribute_defs_id_fk")
  nomenclature     nomenclature   @relation(fields: [nomenclature_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "nomenclature_attributes_nomenclature_id_nomenclature_id_fk")

  @@id([nomenclature_id, attribute_def_id], map: "nomenclature_attributes_nomenclature_id_attribute_def_id_pk")
}

model nomenclature_images {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nomenclature_id String       @db.Uuid
  path            String
  sort            Int          @default(0)
  nomenclature    nomenclature @relation(fields: [nomenclature_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "nomenclature_images_nomenclature_id_nomenclature_id_fk")

  @@index([nomenclature_id])
}

model nomenclature_kit_groups {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nomenclature_id        String                   @db.Uuid
  kind                   String
  name                   String
  sort                   Int                      @default(0)
  nomenclature           nomenclature             @relation(fields: [nomenclature_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "nomenclature_kit_groups_nomenclature_id_nomenclature_id_fk")
  nomenclature_kit_links nomenclature_kit_links[]
}

model nomenclature_kit_links {
  group_id                String                  @db.Uuid
  item_id                 String                  @db.Uuid
  sort                    Int                     @default(0)
  nomenclature_kit_groups nomenclature_kit_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "nomenclature_kit_links_group_id_nomenclature_kit_groups_id_fk")
  kit_items               kit_items               @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "nomenclature_kit_links_item_id_kit_items_id_fk")

  @@id([group_id, item_id], map: "nomenclature_kit_links_group_id_item_id_pk")
}

model order_items {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String         @db.Uuid
  listing_id      String?        @db.Uuid
  nomenclature_id String?        @db.Uuid
  seller_user_id  String?        @db.Uuid
  organization_id String?        @db.Uuid
  title           String
  price_kopeks    Int
  qty             Int
  line_status     line_status    @default(placed)
  options         String         @default("")
  listings        listings?      @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_listing_id_listings_id_fk")
  nomenclature    nomenclature?  @relation(fields: [nomenclature_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_nomenclature_id_nomenclature_id_fk")
  orders          orders         @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_order_id_orders_id_fk")
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_organization_id_organizations_id_fk")
  users           users?         @relation(fields: [seller_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_seller_user_id_users_id_fk")
}

model orders {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_no       Int            @default(autoincrement())
  buyer_id       String?        @db.Uuid
  payment_method payment_method
  fulfillment    fulfillment
  contact_name   String
  phone          String
  city           String         @default("")
  comment        String         @default("")
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  guest_token    String?
  deals          deals?
  order_items    order_items[]
  users          users?         @relation(fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_buyer_id_users_id_fk")

  @@index([guest_token])
}

model organizations {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            org_kind
  name            String
  city            String            @default("")
  phone           String            @default("")
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  listings        listings[]
  order_items     order_items[]
  seller_profiles seller_profiles[]
}

model outbound_emails {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  kind       String
  to_address String
  subject    String
  body_text  String
  body_html  String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)
  send_error String    @default("")
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "outbound_emails_user_id_users_id_fk")
}

model seller_profiles {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String         @unique(map: "seller_profiles_user_id_unique") @db.Uuid
  type            seller_type
  organization_id String?        @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "seller_profiles_organization_id_organizations_id_fk")
  users           users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "seller_profiles_user_id_users_id_fk")
}

model stock_movements {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nomenclature_id String       @db.Uuid
  delta           Int
  reason          stock_reason
  note            String       @default("")
  user_id         String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  nomenclature    nomenclature @relation(fields: [nomenclature_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movements_nomenclature_id_nomenclature_id_fk")
  users           users?       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movements_user_id_users_id_fk")
}

model users {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String            @unique(map: "users_email_unique")
  password_hash      String
  name               String
  phone              String            @default("")
  city               String            @default("")
  staff_role         staff_role?
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  email_verified_at  DateTime?         @db.Timestamptz(6)
  email_verify_token String?           @unique(map: "users_email_verify_token_unique")
  carts              carts?
  customers          customers?
  deal_notes         deal_notes[]
  deals              deals[]
  favorites          favorites[]
  listing_events     listing_events[]
  listings           listings[]
  order_items        order_items[]
  orders             orders[]
  outbound_emails    outbound_emails[]
  seller_profiles    seller_profiles?
  stock_movements    stock_movements[]
  view_history       view_history[]
}

model view_history {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id  String   @db.Uuid
  user_id     String?  @db.Uuid
  guest_token String?
  viewed_at   DateTime @default(now()) @db.Timestamptz(6)
  listings    listings @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "view_history_listing_id_listings_id_fk")
  users       users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "view_history_user_id_users_id_fk")

  @@unique([listing_id, guest_token], map: "view_history_guest_listing")
  @@unique([listing_id, user_id], map: "view_history_user_listing")
}

enum customer_source {
  registration
  order
  manual
}

enum deal_status {
  new
  in_progress
  invoiced
  won
  lost
}

enum fulfillment {
  pickup
  delivery_agreed
}

enum item_condition {
  new
  used
}

enum line_status {
  placed
  confirmed
  completed
  cancelled
}

enum listing_event_kind {
  view
  favorite_add
  favorite_remove
  cart_add
  phone_reveal
}

enum listing_source {
  company
  individual
}

enum listing_status {
  draft
  pending_review
  published
  rejected
  reserved
  archived
}

enum org_kind {
  company
}

enum payment_method {
  invoice
  cash
  agreement
}

enum seller_type {
  individual
}

enum staff_role {
  moderator
  manager
}

enum stock_reason {
  import
  adjustment
  order
  cancel
  complete
  manual
}
