{
  "name": "prolodki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint",
    "db:new": "node scripts/prisma.mjs migrate dev",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "db:setup": "npm run db:migrate && tsx src/db/setup.ts",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop prolodki",
    "pm2:logs": "pm2 logs prolodki",
    "catalog:load": "tsx --env-file=.env src/db/load-boats.ts",
    "catalog:multiply": "tsx --env-file=.env src/db/multiply-catalog.ts",
    "admin:demo": "tsx --env-file=.env src/db/seed-admin-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
